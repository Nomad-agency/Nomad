# История git — самая тяжёлая часть контекста сборки (~1.9 ГБ).
# Без этого COPY . . затягивает её в образ и распаковка статики
# упирается в лимит хостинга.
.git
.gitignore

# Ставятся и собираются внутри образа
node_modules
dist
dist-ssr

# Бэкап оригиналов медиа — не нужен в сборке
.media-backup

# Локальное окружение и мусор
*.local
*.log
.vscode
.idea
.DS_Store
